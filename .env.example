# Copie para .env. O Flask CLI carrega .env por meio de python-dotenv.
# Gere uma chave aleatória local; não use este arquivo para armazenar segredos.
PUC_SECRET_KEY=

# Caminhos relativos são resolvidos a partir da raiz do repositório.
# A fábrica não cria arquivos; o SQLite é preparado pela CLI explícita.
PUC_OCORRENCIAS_JSON=instance/ocorrencias.json
PUC_CONTAS_SQLITE=instance/contas.sqlite3

# Módulo de contas de Luís: formulários Jinja. Desabilitado por padrão.
PUC_CONTAS_HABILITADAS=false

# true no ambiente HTTPS; false apenas durante desenvolvimento HTTP local.
PUC_SESSION_COOKIE_SECURE=false
