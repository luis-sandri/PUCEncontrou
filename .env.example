# Copie para .env. O Flask CLI carrega .env por meio de python-dotenv.
# Gere uma chave aleatória local; não use este arquivo para armazenar segredos.
PUC_SECRET_KEY=

# Caminhos relativos são resolvidos a partir da raiz do repositório.
# A fábrica não cria arquivos; o JSON de contas é preparado pela CLI explícita.
PUC_OCORRENCIAS_JSON=instance/ocorrencias.json
PUC_CONTAS_JSON=instance/contas.json

# Módulo de contas: login e administração de secretários.
PUC_CONTAS_HABILITADAS=true

# Antes do primeiro início, prepare o JSON com o módulo temporariamente desabilitado:
# $env:PUC_OCORRENCIAS_HABILITADAS = "false"
# python -m flask --app app ocorrencias inicializar
# Remove-Item Env:\PUC_OCORRENCIAS_HABILITADAS
PUC_OCORRENCIAS_HABILITADAS=true
PUC_OCORRENCIAS_COMPOSITOR=app.composicao_producao:compor_ocorrencias
PUC_FOTOS_DIRETORIO=instance/fotos

# true no ambiente HTTPS; false apenas durante desenvolvimento HTTP local.
PUC_SESSION_COOKIE_SECURE=false
